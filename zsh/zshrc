export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

# Homebrew has a different default prefix on Apple Silicon, Intel Macs, and
# Linux. Load it before the rest of the tool configuration.
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
elif [ -x /home/linuxbrew/.linuxbrew/bin/brew ]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# history - keep a lot, share it across windows, skip dupes
HISTSIZE=100000
SAVEHIST=100000
HISTFILE="$HOME/.zsh_history"
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

alias v="nvim"
alias gs="git status --short"
alias gl="git log --oneline --graph --decorate"
alias h="herdr"

# eza if installed, plain ls otherwise
if command -v eza >/dev/null 2>&1; then
  alias ll="eza -lah --git"
else
  alias ll="ls -lah"
fi

autoload -Uz compinit
compinit

source_first_available() {
  local plugin_file
  for plugin_file in "$@"; do
    if [ -n "$plugin_file" ] && [ -r "$plugin_file" ]; then
      source "$plugin_file"
      return 0
    fi
  done
  return 1
}

BREW_PREFIX=""
if command -v brew >/dev/null 2>&1; then
  BREW_PREFIX="$(brew --prefix)"
fi

source_first_available \
  "${BREW_PREFIX:+$BREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh}" \
  /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh \
  /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh \
  || true

# Ctrl-R fuzzy history, Ctrl-T fuzzy file pick
if command -v fzf >/dev/null 2>&1; then
  if fzf_shell="$(fzf --zsh 2>/dev/null)"; then
    eval "$fzf_shell"
  else
    source_first_available \
      "${BREW_PREFIX:+$BREW_PREFIX/opt/fzf/shell/completion.zsh}" \
      /usr/share/doc/fzf/examples/completion.zsh \
      /usr/share/fzf/completion.zsh \
      || true
    source_first_available \
      "${BREW_PREFIX:+$BREW_PREFIX/opt/fzf/shell/key-bindings.zsh}" \
      /usr/share/doc/fzf/examples/key-bindings.zsh \
      /usr/share/fzf/key-bindings.zsh \
      || true
  fi
  unset fzf_shell
fi

# smarter cd: `z projects` jumps to frequent dirs
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi

# machine-specific extras (Java, .NET, work stuff) live here, not in the repo
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# Syntax highlighting must be loaded after widgets and machine-local additions.
source_first_available \
  "${BREW_PREFIX:+$BREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh}" \
  /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh \
  || true

unset BREW_PREFIX
unfunction source_first_available
