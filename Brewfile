# Everything this setup needs on a fresh Mac.
# Install with: brew bundle

# terminal
cask "wezterm"
cask "font-hack-nerd-font"

# editor
brew "neovim"
brew "node"     # needed by Mason for pyright, ts_ls, etc.
brew "stylua"

# shell
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "starship"

# git
brew "git"
brew "lazygit"

# search
brew "ripgrep"

# herdr is not on Homebrew - install it separately.
